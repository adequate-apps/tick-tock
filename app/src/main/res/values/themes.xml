<resources>
    <!--
        Platform theme only: no AppCompat, no Material library. The window is
        System Gray so there is never a white flash before Compose draws, and
        the system bars are told the title strip is dark so their icons stay
        legible on Active Blue.
    -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gridline_gray</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/gridline_gray</item>
    </style>
</resources>
