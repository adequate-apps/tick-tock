#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Installed by tools/install-hooks.sh. Scans every pushed range: files, diff,
# author, committer, messages and branch name. Git feeds the ranges on stdin.
root=$(git rev-parse --show-toplevel) || exit 1
scan="$root/tools/identity-scan.sh"
if [ ! -x "$scan" ]; then
    echo "pre-push: $scan is missing; refusing to push unscanned" >&2
    exit 1
fi
exec "$scan" --pre-push
